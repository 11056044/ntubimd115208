    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet replyMessage = \"\";\n\n// 修正防呆：單純檢查是否有拿到資料列，或物件是否為空。移除對 [0].content 的檢查。\nif (items.length === 0 || !items[0].json || Object.keys(items[0].json).length === 0) {\n    replyMessage = \"📋 您今日沒有排定的待辦清單喔！\";\n} else {\n    replyMessage = \"📋 您今日的待辦清單：\\n\";\n    \n    items.forEach((item, index) => {\n        const data = item.json;\n        \n        // 處理時間格式\n        const time = new Date(data.recordtime).toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false });\n        \n        // 狀態判斷\n        const status = data.state ? \"✅\" : \"❌\";\n        \n        // 如果 content 為空字串，就用 carestatus 或預設文字代替，避免畫面顯示空白\n        const displayContent = data.content ? data.content : (data.carestatus || \"未命名行程\");\n        \n        replyMessage += `${index + 1}. [${time}] ${displayContent} (${data.carestatus || '無狀態'}) ${status}\\n`;\n    });\n}\n\nreturn [{\n    json: {\n        lineMessages: [\n            {\n                \"type\": \"text\",\n                \"text\": replyMessage.trim()\n            }\n        ]\n    }\n}];"
      },
