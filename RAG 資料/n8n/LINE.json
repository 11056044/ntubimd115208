    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    c.content, \n    c.recordtime, \n    s.carestatus,\n    c.state\nFROM carerecord c\nJOIN userprofile u ON c.user_id = u.user_id\nLEFT JOIN carestatus s ON c.carestatus_id = s.carestatus_id\nWHERE u.line_id = '{{ $('Get_UserProfile').item.json.line_id }}'\n  AND DATE(c.recordtime) = CURDATE()\nORDER BY c.recordtime ASC;",
        "options": {}
