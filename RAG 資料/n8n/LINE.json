      "parameters": {
        "jsCode": "// 1. 改為直接向 Get_Latest_ID 節點拿取正確的 pregnancyrecord_id\nconst recordId = $('Get_Latest_ID').item.json.pregnancyrecord_id;\n\nif (!recordId) {\n    throw new Error(\"無法從 Get_Latest_ID 節點取得有效的 pregnancyrecord_id\");\n}\n\nconst physicalNames = $('Code in JavaScript').first().json.physicalcondition_names || [];\n\nreturn physicalNames.map(name => {\n  return {\n    json: {\n      pregnancyrecord_id: recordId,\n      physicalcondition_name: name\n    }\n  };\n});"
      },
